# ============================================================================
#  APEX — конфигурация. Скопируйте этот файл в .env и заполните значения.
#  НИКОГДА не публикуйте .env и не присылайте его в чат/мессенджеры.
# ============================================================================

# --- Базовое ---------------------------------------------------------------
# Публичный адрес вашего сайта (с https). Для локального теста: http://localhost:3000
APP_URL=https://apex.example.com
# Домен без http/https — его использует Caddy для автоматического HTTPS.
# Для локального теста: localhost
APP_DOMAIN=apex.example.com
# Произвольное имя, которое увидят друзья
APP_NAME=APEX
# Окружение: development | production
NODE_ENV=production

# --- Секреты приложения ----------------------------------------------------
# Сгенерируйте командой: npm run keygen  (создаст три ключа ниже)
# Ключ шифрования токенов соцсетей (base64, 32 байта). КРИТИЧЕСКИ ВАЖНО хранить в тайне.
TOKEN_ENCRYPTION_KEY=
# Секрет для подписи сессий входа (base64, 32 байта)
SESSION_SECRET=
# Соль для хэширования magic-link токенов (base64, 32 байта)
MAGIC_LINK_SECRET=

# --- База данных и очередь (для Docker оставьте как есть) -------------------
DATABASE_URL=postgresql://apex:ЗАМЕНИТЕ_ПАРОЛЬ@postgres:5432/apex?schema=public
REDIS_URL=redis://redis:6379

# Пароль БД (используется docker-compose). Поменяйте на свой.
POSTGRES_PASSWORD=

# --- Почта для magic-link (вход друзей по ссылке на email) ------------------
# SMTP вашего почтового провайдера. Для теста можно оставить пустым — ссылки
# будут печататься в логах контейнера.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="APEX <no-reply@apex.example.com>"

# --- Доступ владельца ------------------------------------------------------
# Email, который автоматически получит роль владельца (admin) при первом входе.
OWNER_EMAIL=

# ============================================================================
#  КЛЮЧИ ПЛОЩАДОК. Заполняются по чек-листам в папке docs/.
#  Можно заполнять постепенно: что заполнено — то и работает.
# ============================================================================

# --- Meta (Facebook + Instagram) — см. docs/setup-meta.md ------------------
META_APP_ID=
META_APP_SECRET=
# Redirect URI в настройках Meta: {APP_URL}/api/connect/meta/callback

# --- Google / YouTube — см. docs/setup-google-youtube.md -------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI в Google Console: {APP_URL}/api/connect/youtube/callback

# --- TikTok — см. docs/setup-tiktok.md -------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Redirect URI в TikTok: {APP_URL}/api/connect/tiktok/callback

# --- Instagram (вход через Instagram) — отдельные ключи из Instagram API ----
# Берутся в Meta-приложении: сценарий Instagram → Настройка API → Instagram App ID/Secret
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- LinkedIn (self-serve продукт «Share on LinkedIn») --------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Redirect URI в Instagram: {APP_URL}/api/connect/instagram/callback

# --- Видео и публикация ---------------------------------------------------
# Сколько дней хранить исходник после публикации (затем удаляется автоматически).
MEDIA_RETENTION_DAYS=7
# 1 = тестовый прогон: версии видео готовятся, но в сети ничего не отправляется.
PUBLISH_DRY_RUN=
# 1 = включить Facebook-Страницы (нужна бизнес-верификация Meta).
META_ENABLE_FACEBOOK=
# 1 = печатать ссылки входа в лог, если SMTP не настроен (только для своего сервера).
LOG_MAGIC_LINKS=
